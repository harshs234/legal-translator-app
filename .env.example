# ---------- LLM provider (model-agnostic via LiteLLM) ----------
# Pick ONE model string. The matching key is read from that provider's env var.
LLM_MODEL=claude-sonnet-5-5
#   Anthropic : LLM_MODEL=claude-sonnet-5-5     + ANTHROPIC_API_KEY=...
#   OpenAI    : LLM_MODEL=gpt-4o                + OPENAI_API_KEY=...
#   Google    : LLM_MODEL=gemini/gemini-1.5-pro + GEMINI_API_KEY=...
#   Azure     : LLM_MODEL=azure/<deployment>    + AZURE_API_KEY=... + LLM_API_BASE=https://<res>.openai.azure.com
#   Local/OSS : LLM_MODEL=ollama/llama3         + LLM_API_BASE=http://localhost:11434
#   Any OpenAI-compatible server (vLLM, LM Studio, LocalAI):
#               LLM_MODEL=openai/<model-name>   + LLM_API_BASE=http://host:port/v1 + LLM_API_KEY=sk-...

# Provider key (set the one your LLM_MODEL needs):
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: force a key / endpoint regardless of provider (handy for local models)
# LLM_API_KEY=
# LLM_API_BASE=

# ---------- Embeddings (retrieval runs locally; no data leaves the machine) ----------
EMBED_MODEL=intfloat/multilingual-e5-base

# ---------- Stores & corpus ----------
CHROMA_DIR=./chroma_db
TERMS_DB=./terms.db
CORPUS_DIR=./corpus

# Production: drop unreviewed seed rows once you have official/approved data
ALLOWED_STATUS=approved,official,seed
# Cosine-distance cut-off for reference passages; tune on a dev set
MAX_EXAMPLE_DISTANCE=0.22
